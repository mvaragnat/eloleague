<%# One match as a result line: table · player A · score · player B %>
<% d = match_display(tournament, match) %>
<li class="match-row">
  <span class="match-row__table"><%= d[:table] %></span>
  <% %i[a b].each do |key| %>
    <% side = d[key] %>
    <% list_label = t('tournaments.show.view_army_list', default: 'Army list') %>
    <% player_class = class_names('match-row__player', "match-row__player--#{key}",
                                  "match-row__player--#{side[:outcome]}": side[:outcome],
                                  'match-row__player--placeholder': side[:placeholder],
                                  'match-row__player--link': side[:list_path]) %>
    <%# With an army list, the whole player block opens it %>
    <% player_tag = side[:list_path] ? { href: side[:list_path], target: '_blank', rel: 'noopener', title: list_label } : {} %>
    <%= content_tag(side[:list_path] ? :a : :div, class: player_class, **player_tag) do %>
      <span class="match-row__name"><%= side[:name] %></span>
      <% if side[:faction].present? || side[:list_path] %>
        <span class="match-row__details">
          <% if side[:faction].present? %><span class="match-row__faction"><%= side[:faction] %></span><% end %>
          <% if side[:list_path] %>
            <span class="match-row__list" role="img" aria-label="<%= list_label %>">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 1.75h5.5L12.5 4.75v9.5h-8.5z"/><path d="M9.25 1.75v3.25h3.25"/><path d="M6.25 8.25h4M6.25 10.75h4"/></svg>
            </span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% end %>
  <div class="match-row__result">
    <% if d[:played] %>
      <% score = capture do %>
        <span class="match-row__score<%= ' match-row__score--win' if d[:a][:outcome] == :win %>"><%= d[:a][:score] %></span>
        <span class="match-row__sep" aria-hidden="true">–</span>
        <span class="match-row__score<%= ' match-row__score--win' if d[:b][:outcome] == :win %>"><%= d[:b][:score] %></span>
      <% end %>
      <% if d[:link] %>
        <%= link_to score, d[:link], class: 'match-row__scores match-row__scores--link', title: t('tournaments.open') %>
      <% else %>
        <span class="match-row__scores"><%= score %></span>
      <% end %>
    <% elsif d[:link] %>
      <%= link_to t('tournaments.open'), d[:link], class: 'match-row__open' %>
    <% else %>
      <span class="match-row__status"><%= d[:status] %></span>
    <% end %>
  </div>
</li>
